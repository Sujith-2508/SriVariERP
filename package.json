{
  "name": "sri-vari-enterprises",
  "version": "1.0.0",
  "description": "Billing and Collections ERP System",
  "author": "Sri Vari Enterprises",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "lint": "tsc --noEmit --pretty false --incremental false",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "npx playwright test",
    "verify:dev": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run build:clean",
    "build": "next build",
    "build:clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\" && next build",
    "start": "next start",
    "export": "next build",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build:electron": "cross-env ELECTRON_BUILD=1 next build && electron-builder",
    "build:win": "cross-env ELECTRON_BUILD=1 next build && electron-builder --win",
    "build:mac": "cross-env ELECTRON_BUILD=1 next build && electron-builder --mac",
    "build:all": "cross-env ELECTRON_BUILD=1 next build && electron-builder --win --mac",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.srivari.erp",
    "afterPack": "./scripts/afterPack.js",
    "compression": "maximum",
    "icon": "public/icon.png",
    "win": {
      "icon": "public/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sri Vari ERP",
      "artifactName": "${productName} v${version} ${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version} ${arch}.${ext}"
    },
    "mac": {
      "icon": "public/icon.png"
    },
    "linux": {
      "icon": "public/icon.png"
    },
    "files": [
      "out/**/*",
      "main.js",
      "preload.js",
      ".env.local",
      "public/icon.ico",
      "public/icon.png"
    ],
    "asar": true,
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.8",
    "@supabase/supabase-js": "^2.93.3",
    "@types/leaflet": "^1.9.21",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.1",
    "googleapis": "^171.4.0",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "next": "^15.1.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.58.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^3.4.1",
    "whatsapp-web.js": "^1.34.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^27.0.1",
    "msw": "^2.12.14",
    "playwright-core": "^1.58.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.1"
  }
}
